# --- Slack app (Socket Mode) ---
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token
SLACK_SIGNING_SECRET=your-signing-secret

# Comma-separated Slack channel IDs to watch. Leave empty to watch every
# channel the bot has been invited to.
TRACK_CHANNEL_IDS=C021PFZ1B53

# Post a short thread reply confirming a ticket was tracked (true/false)
POST_CONFIRMATION_REPLY=true

# --- JIRA ---
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=you@yourcompany.com
JIRA_API_TOKEN=your-jira-api-token

# How often (minutes) to re-poll JIRA and refresh status/assignee for
# tickets already tracked.
SYNC_INTERVAL_MINUTES=30

# --- Tracker webpage ---
PORT=3000
# Where the tracked-ticket data is stored on disk.
DB_PATH=./data/tickets.json
