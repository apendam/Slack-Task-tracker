# --- Slack app (Socket Mode) ---
# If your Slack app does NOT have "Token Rotation" enabled (Basic
# Information -> OAuth & Permissions), just set this to your permanent
# Bot User OAuth Token and leave the three rotation vars below blank.
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token
SLACK_SIGNING_SECRET=your-signing-secret

# If your Slack app DOES have Token Rotation enabled, the install page
# gives you a short-lived (12h) access token plus a refresh token instead
# of a permanent one. Fill these three in (SLACK_BOT_TOKEN above is then
# ignored) and the app will keep itself refreshed automatically.
# - SLACK_CLIENT_ID / SLACK_CLIENT_SECRET: Basic Information -> App Credentials
# - SLACK_REFRESH_TOKEN: the refresh token (starts xoxe-1-...) shown after
#   installing the app - not the 12h access token.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REFRESH_TOKEN=

# Comma-separated Slack channel IDs to watch. Leave empty to watch every
# channel the bot has been invited to.
TRACK_CHANNEL_IDS=C021PFZ1B53

# Post a short thread reply confirming a ticket was tracked (true/false)
POST_CONFIRMATION_REPLY=true

# --- JIRA ---
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=you@yourcompany.com
JIRA_API_TOKEN=your-jira-api-token

# How often (minutes) to re-poll JIRA and refresh status/assignee for
# tickets already tracked.
SYNC_INTERVAL_MINUTES=30

# --- Tracker webpage ---
PORT=3000
# Where the tracked-ticket data is stored on disk.
DB_PATH=./data/tickets.json
